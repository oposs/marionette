{
  "mcpServers": {
    "svelte": {
      "type": "http",
      "url": "https://mcp.svelte.dev/mcp"
    },
    "shadcn-svelte": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://shadcn-svelte.mastra.cloud/api/mcp/shadcn/mcp"
      ]
    },
    "rust-docs": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://rust-docs.mastra.cloud/api/mcp/rust-docs/mcp"
      ]
    }
  }
}